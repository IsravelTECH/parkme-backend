# ParkMe Backend Environment Variables Template
# Copy this file to .env and configure your values

# MongoDB Atlas Connection
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=parkme

# JWT Authentication Secret Key (Generate with: openssl rand -hex 32)
SECRET_KEY=your_generated_32_byte_secret_key_here

# Stripe Payments Integration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Client App URLs & CORS
FRONTEND_URL=http://localhost:3005
ALLOWED_ORIGINS=http://localhost:3005,http://127.0.0.1:3005,http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:5501
